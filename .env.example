# Sanity CMS configuration.
#
# Copy this file to .env.local and fill in the values:
#   cp .env.example .env.local
#
# .env.local is gitignored. Never commit real values.
#
# Where to find these:
#   - Vercel:  Project Settings -> Environment Variables (they are already set there)
#   - Sanity:  https://www.sanity.io/manage -> select the project
#
# All three are NEXT_PUBLIC_, so they are inlined into the browser bundle. That
# is expected for Sanity: the project ID and dataset are not secrets, and the
# client only ever reads published content. Do not put an API token here — a
# token would be a real secret and must never carry the NEXT_PUBLIC_ prefix.

# Required. The Sanity project ID, e.g. "ab12cd34".
# Missing -> the app throws "Missing environment variable: NEXT_PUBLIC_SANITY_PROJECT_ID".
NEXT_PUBLIC_SANITY_PROJECT_ID=

# Required. Usually "production".
# Missing -> the app throws "Missing environment variable: NEXT_PUBLIC_SANITY_DATASET".
NEXT_PUBLIC_SANITY_DATASET=production

# Optional. Pins the Sanity API to a date so future API changes cannot break
# the site. Defaults to 2023-10-08 (see src/sanity/env.ts) when unset.
NEXT_PUBLIC_SANITY_API_VERSION=2023-10-08

# --- Site URL ---
# Used for canonical URLs, Open Graph URLs, JSON-LD and the sitemap, all of
# which must be absolute. Falls back to the Vercel deployment URL, so previews
# and production are already correct; set this once a real domain is attached.
NEXT_PUBLIC_SITE_URL=

# --- Contact form (Resend) ---
# Without all three the /api/contact route returns 503 and the form tells the
# visitor it is unavailable rather than silently failing.
#
# Get an API key at https://resend.com (free tier is ample for a portfolio).

# Server-only secret. Must NOT have the NEXT_PUBLIC_ prefix — that would inline
# it into the browser bundle for anyone to read.
RESEND_API_KEY=

# Where enquiries are delivered.
CONTACT_TO_EMAIL=

# The from-address. Must be on a domain verified in Resend. To try it before
# verifying a domain, Resend's shared sender works: onboarding@resend.dev
CONTACT_FROM_EMAIL=
